AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
LOOPS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Joshua Omole <hello@joshuaomole.com>"
RESEND_REPLY_TO=hello@joshuaomole.com
GEMINI_API_KEY=
SITE_URL=https://joshuaomole.com

# Clarity Map IP Rate Limiting (shared across Vercel Serverless & Node instances)
# Required in production: random 32+ char secret used for HMAC-SHA256 hashing of client IPs (never store raw IPs)
RATE_LIMIT_SECRET=
# Upstash Redis REST API URL (also supports Vercel KV alias KV_REST_API_URL)
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST API token (also supports Vercel KV alias KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_TOKEN=
# Optional comma-separated IPv4/IPv6 addresses exempt from Clarity Map generation limits
RATE_LIMIT_ALLOWLIST=
# Maximum generated Clarity Maps allowed per IP within the rolling window (default: 2)
GEN_LIMIT_PER_WINDOW=2
# Rolling rate-limit window duration in seconds (default: 86400 = 24 hours)
GEN_WINDOW_SECONDS=86400
# Shared fallback bucket limit when client IP cannot be determined (default: 10)
UNKNOWN_IP_LIMIT=10
# Optional site-wide daily generation cap across all IPs; 0 disables global cap (default: 0)
GLOBAL_DAILY_GENERATION_CAP=0

# Optional Gemini model override (defaults to gemini-4-hydrogen) and fallback model
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Temporary diagnostics token for GET /api/clarity-map/health (remove after verifying production)
DIAGNOSTICS_TOKEN=

